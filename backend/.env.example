# Copy to backend/.env and fill in. Never commit .env.
GEMINI_API_KEY=
# Any Gemini free-tier model id. Defaults to gemini-3.5-flash; override here if
# that model has been retired for your account.
GEMINI_MODEL=gemini-3.5-flash
# Second LLM call that fact-checks rewrites (slower; uses more free-tier quota).
ENABLE_VERIFY_CALL=false
# Overall deadline for one tailoring request, in seconds.
TAILOR_DEADLINE_SECONDS=240

# --- Deployment: persistence (leave empty for local development) ---
# Postgres connection string; empty = local SQLite (backend/data/app.db).
# "postgres://" / "postgresql://" are converted to the psycopg driver.
DATABASE_URL=
# Archive file storage: "local" (backend/uploads/resumes) or "supabase".
STORAGE_BACKEND=local
SUPABASE_URL=
# Service-role key: server-side only, never expose to the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# --- Deployment: access control and limits ---
# "production" requires ACCESS_PASSWORD (12+ chars) and hides /docs.
APP_ENV=development
# Empty = no sign-in (local only). Set in production.
ACCESS_PASSWORD=
# Frontend origins allowed by CORS, comma-separated (e.g. https://your-app.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TAILOR_RATE_LIMIT_PER_HOUR=30
LOGIN_ATTEMPTS_PER_15_MINUTES=10

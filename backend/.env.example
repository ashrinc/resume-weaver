# Copy to backend/.env and fill in. Never commit .env.
GEMINI_API_KEY=
# Any Gemini free-tier model id. Defaults to gemini-3.5-flash; override here if
# that model has been retired for your account.
GEMINI_MODEL=gemini-3.5-flash
# Second LLM call that fact-checks rewrites (slower; uses more free-tier quota).
ENABLE_VERIFY_CALL=false
# Overall deadline for one tailoring request, in seconds.
TAILOR_DEADLINE_SECONDS=90
